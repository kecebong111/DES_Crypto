generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OperationType {
  ENCRYPT
  DECRYPT
  KEY_SCHEDULE
}

model OperationLog {
  id        String        @id @default(cuid())
  operation OperationType
  algorithm String        @default("DES")
  createdAt DateTime      @default(now())
}
