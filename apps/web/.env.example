# Server only. Never prefix these with NEXT_PUBLIC_.
CRYPTO_API_URL=http://127.0.0.1:8000
CRYPTO_API_TIMEOUT_MS=5000
# Neon pooled URL: application queries only. Replace every placeholder.
DATABASE_URL=postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Neon direct URL: Prisma CLI schema/migration tooling only.
DIRECT_URL=postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/DBNAME?sslmode=require
